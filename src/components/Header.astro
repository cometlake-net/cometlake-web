---
// src/components/Header.astro
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
  { href: "/gallery", label: "Gallery" },
  { href: "/link", label: "Links" },
];
---

<header class="w-full bg-white border-b border-gray-200 text-sm dark:bg-gray-900 dark:border-gray-700 dark:text-gray-100">
  <nav class="max-w-[85rem] mx-auto px-4 flex items-center justify-between" aria-label="Global">
    <a href="/" class="py-3 text-xl font-semibold dark:text-white">cometlake.net</a>
    <div class="flex items-center gap-6">
      <ul class="flex items-center gap-6">
        {links.map((link) => (
          <li>
            <a href={link.href} class="py-2 text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white">{link.label}</a>
          </li>
        ))}
      </ul>
      <button
        type="button"
        id="theme-toggle"
        class="p-2 rounded-lg text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800"
        aria-label="ダークモード切り替え"
      >
        <svg class="size-5 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="size-5 hidden dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
  });
</script>
