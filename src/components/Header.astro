---
// src/components/Header.astro
const links = [
  { href: "/about", label: "About" },
  { href: "/gallery", label: "Gallery" },
  { href: "/links", label: "Links" },
];
---

<header class="sticky top-0 inset-x-0 z-50 w-full flex flex-wrap md:justify-start md:flex-nowrap py-3 bg-navbar/90 backdrop-blur supports-[backdrop-filter]:bg-navbar/75">
  <nav class="relative max-w-[85rem] w-full flex flex-wrap items-center justify-between md:flex-nowrap md:gap-3 mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Logo -->
    <a class="flex-none font-semibold text-xl text-foreground focus:outline-hidden focus:opacity-80" href="/" aria-label="Brand">cometlake.net</a>

    <!-- Theme Toggle & Collapse Button（モバイルでは右上、PCではメニューの右端） -->
    <div class="flex items-center gap-1 md:order-3 md:ps-2 md:before:block before:hidden before:w-px before:h-4 before:me-1 before:bg-navbar-divider">
      <button id="theme-toggle" type="button" class="flex items-center justify-center size-9 text-foreground rounded-md hover:text-primary focus:outline-hidden dark:hover:text-muted-foreground-1" aria-label="ダークモード切り替え">
        <!-- ライト時は月、ダーク時は太陽を表示 -->
        <svg class="size-4 dark:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        <svg class="size-4 hidden dark:block" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2m-7.07-14.93 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"/></svg>
      </button>
      <button id="hs-header-classic-collapse" type="button" class="hs-collapse-toggle md:hidden flex items-center justify-center size-9 text-foreground rounded-md hover:text-primary focus:outline-hidden dark:hover:text-muted-foreground-1" aria-expanded="false" aria-controls="hs-header-classic" aria-label="メニューを開閉" data-hs-collapse="#hs-header-classic">
        <!-- 閉じている時はハンバーガー、開いている時は× -->
        <svg class="hs-collapse-open:hidden size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" x2="21" y1="6" y2="6"/><line x1="3" x2="21" y1="12" y2="12"/><line x1="3" x2="21" y1="18" y2="18"/></svg>
        <svg class="hs-collapse-open:block hidden size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>

    <!-- Collapse（モバイルでは折りたたみ、PCでは常に表示） -->
    <div id="hs-header-classic" class="hs-collapse hidden overflow-hidden transition-all duration-300 basis-full grow md:block md:basis-auto md:order-2" aria-labelledby="hs-header-classic-collapse" role="region">
      <div class="overflow-hidden overflow-y-auto max-h-[75vh] [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-none [&::-webkit-scrollbar-track]:bg-scrollbar-track [&::-webkit-scrollbar-thumb]:bg-scrollbar-thumb">
        <div class="flex flex-col mt-5 md:flex-row md:items-center md:justify-end md:mt-0">
          {links.map((link) => (
            <a class="inline-flex items-center py-2 md:px-2 text-sm font-medium text-foreground rounded-lg hover:text-primary focus:outline-hidden focus:text-primary dark:hover:text-muted-foreground-1 dark:focus:text-muted-foreground-1" href={link.href}>{link.label}</a>
          ))}
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  // Preline の Collapse プラグイン（ハンバーガーメニューの開閉）
  // Preline does not ship TypeScript declarations for this plugin.
  // @ts-expect-error The plugin is available at runtime.
  import HSCollapse from "preline/plugins/collapse-non-auto";

  HSCollapse.autoInit();

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {}
  });
</script>