---
import CommonLayout from "../layouts/CommonLayout.astro";
import Card from "../components/Card.astro";
import GalleryLightbox from "../components/GalleryLightbox.astro";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

// ベントーグリッドのタイルの大きさ。画像の並び順にこのパターンを繰り返す
// （large: 2×2 / wide: 2×1 / tall: 1×2 / small: 1×1）
const tileClasses = {
  large: "col-span-2 row-span-2",
  wide: "col-span-2",
  tall: "row-span-2",
  small: "",
};
const tiles = ["large", "small", "tall", "small", "wide", "small", "small", "small", "wide"] as const;

// src/assets/gallery に画像を置くと自動で並ぶ。
// ファイル名は日付（例: 26-03-27.png）にして、新しい順に表示する。日付でないファイル名は最後に回す
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const fileName = (path: string) => path.split("/").pop() ?? path;
const isDated = (path: string) => /^\d/.test(fileName(path));
const byNewest = (a: string, b: string) =>
  Number(isDated(b)) - Number(isDated(a)) ||
  fileName(b).localeCompare(fileName(a), undefined, { numeric: true });

const photos = await Promise.all(
  Object.keys(modules)
    .sort(byNewest)
    .map(async (path, i) => {
      const src = modules[path].default;
      // 拡大表示用（クリックしたときだけ読み込む）
      const full = await getImage({ src, width: Math.min(src.width, 1920), format: "webp" });
      return { src, fullSrc: full.src, alt: `ギャラリー画像 ${i + 1}`, tile: tiles[i % tiles.length] };
    }),
);
---
<CommonLayout title="Gallery" description="Gallery of cometlake.net">

  <Card as="section" class="max-w-5xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-bold text-foreground">Gallery</h1>

    <!-- 行の高さを列幅と同じにして、タイルを正方形のグリッドに揃える（gap-2 = spacing×2、列数-1 個ぶんの隙間を引く） -->
    {photos.length > 0 ? (
      <div class="@container mt-6">
        <div class="grid grid-flow-dense gap-2 grid-cols-3 auto-rows-[calc((100cqw-var(--spacing)*4)/3)] @xl:grid-cols-4 @xl:auto-rows-[calc((100cqw-var(--spacing)*6)/4)] @3xl:grid-cols-6 @3xl:auto-rows-[calc((100cqw-var(--spacing)*10)/6)]">
        {photos.map((photo, i) => (
          <button
            type="button"
            class:list={[
              "group block overflow-hidden rounded-lg bg-muted focus:outline-hidden focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-card",
              tileClasses[photo.tile],
            ]}
            data-gallery-item
            data-index={i}
            data-full-src={photo.fullSrc}
            data-alt={photo.alt}
            aria-label={`${photo.alt}を拡大表示`}
          >
            <Image
              src={photo.src}
              alt={photo.alt}
              width={photo.tile === "small" ? 400 : 800}
              format="webp"
              class="size-full object-cover transition-transform duration-300 group-hover:scale-105 group-focus:scale-105"
            />
          </button>
        ))}
        </div>
      </div>
    ) : (
      <p class="mt-6 text-muted-foreground-1">まだ写真がありません。</p>
    )}
  </Card>

  <GalleryLightbox />
</CommonLayout>
