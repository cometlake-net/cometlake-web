---
import CommonLayout from "../layouts/CommonLayout.astro";
import Card from "../components/Card.astro";
import GalleryLightbox from "../components/GalleryLightbox.astro";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import bg from "../assets/home/bg.jpg";

// src/assets/gallery に画像を置くと、ファイル名順に自動で並ぶ
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const photos = await Promise.all(
  Object.keys(modules)
    .sort()
    .map(async (path, i) => {
      const src = modules[path].default;
      // 拡大表示用（クリックしたときだけ読み込む）
      const full = await getImage({ src, width: Math.min(src.width, 1920), format: "webp" });
      return { src, fullSrc: full.src, alt: `ギャラリー画像 ${i + 1}` };
    }),
);
---
<CommonLayout title="Gallery" description="Gallery of cometlake.net">
  <Image slot="background" src={bg} alt="" class="fixed inset-0 -z-10 size-full object-cover" />

  <Card as="section" class="max-w-5xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-bold text-foreground">Gallery</h1>

    {photos.length > 0 ? (
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4">
        {photos.map((photo, i) => (
          <button
            type="button"
            class="group block overflow-hidden rounded-xl focus:outline-hidden focus:ring-2 focus:ring-primary"
            data-gallery-item
            data-index={i}
            data-full-src={photo.fullSrc}
            data-alt={photo.alt}
            aria-label={`${photo.alt}を拡大表示`}
          >
            <Image
              src={photo.src}
              alt={photo.alt}
              width={600}
              format="webp"
              class="aspect-square size-full object-cover transition-transform duration-300 group-hover:scale-105 group-focus:scale-105"
            />
          </button>
        ))}
      </div>
    ) : (
      <p class="mt-6 text-muted-foreground-1">まだ写真がありません。</p>
    )}
  </Card>

  <GalleryLightbox />
</CommonLayout>
