---
import CommonLayout from '../layouts/CommonLayout.astro';
import Card from '../components/Card.astro';
import { Image } from 'astro:assets';
// 写真を用意したら下の行を有効にして、profile.photo に設定する
import photo from '../assets/about/photo.jpg';

// 仮の自己紹介文(あとで差し替える)
const profile = {
  name: 'sakimori',
  reading: 'さきもり',
  bio: [
      `ここって何書けばいいの？`,

  ],
  photo,
};
---
<CommonLayout title="About" description="About cometlake.net">

  <Card as="section" class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center sm:items-start gap-6">
    <!-- 写真（未設定のあいだは仮置きのアイコンを表示） -->
    <div class="shrink-0">
      {profile.photo ? (
        <Image src={profile.photo} alt={profile.name} class="w-48 sm:w-56 md:w-72 aspect-3/4 rounded-xl object-cover" />
      ) : (
        <div class="flex items-center justify-center w-48 sm:w-56 md:w-72 aspect-3/4 rounded-xl bg-muted text-muted-foreground">
          <svg class="size-20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
        </div>
      )}
    </div>

    <div class="text-center sm:text-start">
      <h1 class="text-3xl md:text-4xl font-bold text-foreground">{profile.name}</h1>
      <p class="mt-2 text-sm tracking-widest text-muted-foreground-1">{profile.reading}</p>
      <div class="mt-4 space-y-3 text-foreground whitespace-pre-line">
        {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </Card>
</CommonLayout>
